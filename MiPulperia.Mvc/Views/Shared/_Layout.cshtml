<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiPulperia.Mvc</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MiPulperia.Mvc.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MiPulperia.Mvc</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                            asp-controller="Sucursales"
                            asp-action="Index">
                                Sucursales
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                            asp-controller="Clientes"
                            asp-action="Index">
                                Clientes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                            asp-controller="Productos"
                            asp-action="Index">
                                Productos
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MiPulperia.Mvc - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
    $(function () {
        const ruta = window.location.pathname.toLowerCase();

        const modulos = [
            "/clientes",
            "/productos",
            "/sucursales"
        ];

        if (!modulos.some(m => ruta === m || ruta === m + "/index")) {
            return;
        }

        const tabla = $("table").first();

        if (!tabla.length) return;

        tabla.before(`
            <div class="mb-3">
                <label class="form-label">Buscar registros</label>
                <input type="text"
                       id="buscadorRegistros"
                       class="form-control"
                       placeholder="Escriba el nombre que desea buscar...">
                <small id="resultadoBusqueda"
                       class="text-muted"></small>
            </div>
        `);

        $("#buscadorRegistros").on("input", function () {
            const texto = normalizar($(this).val());
            let total = 0;

            tabla.find("tbody tr").each(function () {
                const coincide = normalizar($(this).text()).includes(texto);
                $(this).toggle(coincide);

                if (coincide) total++;
            });

            $("#resultadoBusqueda").text(
                total + " registro(s) encontrado(s)"
            );
        });

        function normalizar(texto) {
            return texto.toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "");
        }
    });
</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
