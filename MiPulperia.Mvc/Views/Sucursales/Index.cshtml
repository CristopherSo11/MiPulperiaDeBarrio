
@model List<MiPulperia.Model.Sucursal>

@{
    ViewData["Title"] = "Sucursales";
}

<div class="container mt-4">

    <h2 class="mb-3">Sucursales de Mi Pulpería</h2>

    <p class="text-muted">
        Listado de sucursales registradas en el sistema.
    </p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <a asp-controller="Sucursales"
       asp-action="Crear"
       class="btn btn-primary mb-3">
        + Nueva sucursal
    </a>

    <div class="table-responsive">

        <table class="table table-striped table-bordered table-hover">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var sucursal in Model)
                    {
                        <tr>
                            <td>@sucursal.IdSucursal</td>

                            <td>@sucursal.Nombre</td>

                            <td>@sucursal.Direccion</td>

                            <td>
                                @(sucursal.Telefono ?? "Sin teléfono")
                            </td>

                            <td>
                                @if (sucursal.Activa)
                                {
                                    <span class="badge bg-success">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactiva
                                    </span>
                                }
                            </td>
                            
                            <td>
                                <a asp-controller="Sucursales"
                                asp-action="Editar"
                                asp-route-id="@sucursal.IdSucursal"
                                class="btn btn-warning btn-sm me-1">
                                    Editar
                                </a>
                                <a asp-controller="Sucursales"
                                asp-action="Eliminar"
                                asp-route-id="@sucursal.IdSucursal"
                                class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6"
                            class="text-center text-muted">
                            No hay sucursales registradas.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
